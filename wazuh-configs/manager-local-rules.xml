<!-- Add this to /var/ossec/etc/rules/local_rules.xml on the Wazuh Manager -->
<group name="loki,loki_app,">

  <!-- Parent Rule: Matches all Loki JSON events (both container and router logs) -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">grafana-loki|router-gateway</field>
    <description>Loki Integration: Loki-style JSON log ingested</description>
  </rule>

  <!-- Rule: Application Error Logs -->
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="level">^ERROR$</field>
    <description>Loki Integration: Application Error detected on $(device_name) (App: $(app))</description>
    <group>loki_error,</group>
  </rule>

  <!-- Rule: Application Critical Logs -->
  <rule id="100102" level="8">
    <if_sid>100100</if_sid>
    <field name="level">^CRITICAL$</field>
    <description>Loki Integration: Application Critical event detected on $(device_name) (App: $(app))</description>
    <group>loki_critical,</group>
  </rule>

  <!-- Rule: Authentication Failures -->
  <rule id="100103" level="7">
    <if_sid>100100</if_sid>
    <field name="message">authentication failed|unauthorized|Unauthorized|failed for admin</field>
    <description>Loki Integration: Authentication failure detected on $(device_name) (App: $(app))</description>
    <group>authentication_failed,loki_security,</group>
  </rule>

  <!-- Rule: Kubernetes Container/Pod Restarts / Router Changes -->
  <rule id="100104" level="5">
    <if_sid>100100</if_sid>
    <field name="message">restarted by Kubernetes|container restarted|changed state to</field>
    <description>Loki Integration: State change / restart detected on $(device_name) (Msg: $(message))</description>
    <group>loki_state_change,loki_k8s,loki_container,</group>
  </rule>

  <!-- Rule: High Severity Application Resource Events -->
  <rule id="100105" level="7">
    <if_sid>100100</if_sid>
    <field name="message">exceeded threshold|utilization above 90%|timeout|exhausted</field>
    <description>Loki Integration: Resource issue / timeout on $(device_name): $(message)</description>
    <group>loki_resource,</group>
  </rule>

</group>
